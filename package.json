{
  "name": "carte-du-ciel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Carte du Ciel — ouverture de pochettes de planches célestes en 3D (Three.js)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "render:plates": "node scripts/render-plates.mjs",
    "make:icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "@types/three": "0.169.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
